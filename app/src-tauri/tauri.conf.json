{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixelfed Importer",
  "version": "1.0.0",
  "identifier": "app.pixelfed-importer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pixelfed Importer",
        "width": 1180,
        "height": 820,
        "minWidth": 820,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Instagram-Export zu Pixelfed importieren",
    "windows": {
      "nsis": {
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
